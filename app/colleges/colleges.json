// app/colleges/page.tsx

import Link from "next/link";
import collegesData from "@/app/data/colleges.json";

type College = {
  name: string;
  category: string;
  location?: string;
  slug?: string;
  website?: string;
  notes?: string;
};

export default function Page() {
  const colleges = collegesData as College[];

  return (
    <main className="px-6 py-8 max-w-5xl mx-auto space-y-6">
      <header>
        <h1 className="text-3xl font-bold mb-2">Colleges</h1>
        <p className="text-sm text-zinc-400">
          All the schools you&apos;re tracking for your transfer cycle.
        </p>
      </header>

      <section className="grid gap-4 md:grid-cols-2">
        {colleges.map((college) => (
          <Link
            key={college.slug ?? college.name}
            href={`/colleges/${college.slug}`}
            className="block rounded-2xl border border-zinc-800 bg-zinc-900/60 p-4 hover:border-zinc-500 transition"
          >
            <h2 className="text-lg font-semibold">{college.name}</h2>

            {college.location && (
              <p className="text-sm text-zinc-400">{college.location}</p>
            )}

            <p className="mt-2 text-xs uppercase tracking-wide text-zinc-500">
              {college.category}
            </p>

            {college.notes && (
              <p className="mt-2 text-xs text-zinc-400 line-clamp-2">
                {college.notes}
              </p>
            )}
          </Link>
        ))}
      </section>
    </main>
  );
}
